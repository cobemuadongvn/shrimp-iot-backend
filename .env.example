SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shrimp_iot
DB_USER=shrimp_user
DB_PASSWORD=change_me_dev_password
DB_SSLMODE=disable
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
IOT_API_KEY=replace_with_a_long_random_device_api_key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://175.16.16.108:5173,http://175.16.16.108:3000,http://192.168.1.*:5173,http://192.168.1.*:3000
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
# QCVN 02-19:2014/BNNPTNT default thresholds
TEMP_MIN=18
TEMP_MAX=33
PH_MIN=7.0
PH_MAX=9.0
SALINITY_MIN=5
SALINITY_MAX=35
DO_MIN=3.5

# Optional Python AI service. Keep false when you only want QCVN rule-based evaluation.
AI_ENABLED=true
AI_SERVICE_URL=http://175.16.16.108:8001/predict
AI_TIMEOUT_MS=3000

# Optional OpenAI LLM assistant for /api/chat/message.
# Put the real key only in .env.local or environment variables, never in this example file.
OPENAI_CHAT_ENABLED=false
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_TIMEOUT_MS=8000
OPENAI_CHAT_MAX_OUTPUT_TOKENS=700
# OPENAI_API_KEY=

# In-app notifications are stored in DB and exposed to frontend/app.
APP_NOTIFICATION_ENABLED=true

# Optional notification webhooks
SMS_NOTIFICATION_ENABLED=false
EMAIL_NOTIFICATION_ENABLED=false
SMS_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
DEFAULT_SMS_RECIPIENT=
DEFAULT_EMAIL_RECIPIENT=

REPORT_MAX_EXPORT_ROWS=5000

# One-time device claim code lifetime used in provisioning QR generation.
PROVISIONING_CLAIM_EXPIRATION_MINUTES=1440

# MQTT for device <-> backend communication
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_REQUIRED=false
MQTT_HOSTNAME_VERIFICATION_ENABLED=true
MQTT_CREDENTIALS_REQUIRED=false
MQTT_BACKEND_CLIENT_ID=shrimp-iot-backend
MQTT_QOS=1
MQTT_TELEMETRY_TOPIC_PATTERN=shrimp-iot/devices/+/telemetry
MQTT_ACK_TOPIC_PATTERN=shrimp-iot/devices/+/commands/ack
MQTT_STATUS_TOPIC_PATTERN=shrimp-iot/devices/+/status
MQTT_COMMAND_TOPIC_TEMPLATE=shrimp-iot/devices/{deviceId}/commands
MQTT_COMMAND_RETRY_MS=5000
COMMAND_DEFAULT_EXPIRATION_SECONDS=60

# Device offline detection
# Scheduler checks every 30 seconds. If a device has no telemetry/ACK/status for 60 seconds, it is marked OFFLINE.
# MQTT Last Will OFFLINE also opens DEVICE_OFFLINE alert immediately.
DEVICE_OFFLINE_SECONDS=60
DEVICE_OFFLINE_CHECK_MS=30000
SEED_DEMO_DATA_ENABLED=false
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_TECH_PASSWORD=

# Existing non-empty databases need a one-time Flyway baseline before normal startup.
# Keep FLYWAY_BASELINE_ON_MIGRATE=false after that one-time operation.
# SEED_DEMO_DATA_ENABLED=false

# Notification anti-spam / duplicate suppression
NOTIFICATION_ANTI_SPAM_ENABLED=true
NOTIFICATION_COOLDOWN_MINUTES=30

# pgAdmin container login. Use a real-looking domain; .local is rejected by recent pgAdmin builds.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_pgadmin_password
