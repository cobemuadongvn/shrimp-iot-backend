# Copy to .env.mqtt-cloud.local after creating the managed MQTT cluster.
# Keep the real file outside Git.
MQTT_ENABLED=true
MQTT_BROKER_URL=ssl://YOUR_HIVEMQ_CLUSTER_HOST:8883
MQTT_USERNAME=YOUR_BACKEND_MQTT_USERNAME
MQTT_PASSWORD=YOUR_BACKEND_MQTT_PASSWORD
MQTT_TLS_REQUIRED=true
MQTT_HOSTNAME_VERIFICATION_ENABLED=true
MQTT_CREDENTIALS_REQUIRED=true
MQTT_BACKEND_CLIENT_ID=shrimp-iot-backend-cloud
MQTT_QOS=1
AI_ENABLED=false
