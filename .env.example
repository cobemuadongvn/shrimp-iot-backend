SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shrimp_iot
DB_USER=shrimp_user
DB_PASSWORD=change_me_dev_password
IOT_API_KEY=MY_SECRET_KEY
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.1.89:5173,http://192.168.1.89:3000
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
# QCVN 02-19:2014/BNNPTNT default thresholds
TEMP_MIN=18
TEMP_MAX=33
PH_MIN=7.0
PH_MAX=9.0
SALINITY_MIN=5
SALINITY_MAX=35
DO_MIN=3.5

# Optional Python AI service. Keep false when you only want QCVN rule-based evaluation.
AI_ENABLED=true
AI_SERVICE_URL=http://192.168.1.89:8001/predict
AI_TIMEOUT_MS=3000

# In-app notifications are stored in DB and exposed to frontend/app.
APP_NOTIFICATION_ENABLED=true

# Optional notification webhooks
SMS_NOTIFICATION_ENABLED=false
EMAIL_NOTIFICATION_ENABLED=false
SMS_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
DEFAULT_SMS_RECIPIENT=
DEFAULT_EMAIL_RECIPIENT=

REPORT_MAX_EXPORT_ROWS=5000

# MQTT for device <-> backend communication
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://192.168.1.89:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BACKEND_CLIENT_ID=shrimp-iot-backend
MQTT_QOS=1
MQTT_TELEMETRY_TOPIC_PATTERN=shrimp-iot/devices/+/telemetry
MQTT_ACK_TOPIC_PATTERN=shrimp-iot/devices/+/commands/ack
MQTT_STATUS_TOPIC_PATTERN=shrimp-iot/devices/+/status
MQTT_COMMAND_TOPIC_TEMPLATE=shrimp-iot/devices/{deviceId}/commands
MQTT_COMMAND_RETRY_MS=5000
COMMAND_DEFAULT_EXPIRATION_SECONDS=60

# Device offline detection
# Scheduler checks every 30 seconds. If a device has no telemetry/ACK/status for 60 seconds, it is marked OFFLINE.
# MQTT Last Will OFFLINE also opens DEVICE_OFFLINE alert immediately.
DEVICE_OFFLINE_SECONDS=60
DEVICE_OFFLINE_CHECK_MS=30000
SEED_DEMO_DATA_ENABLED=true

# Production recommendation
# JPA_DDL_AUTO=validate
# SEED_DEMO_DATA_ENABLED=false

# Notification anti-spam / duplicate suppression
NOTIFICATION_ANTI_SPAM_ENABLED=true
NOTIFICATION_COOLDOWN_MINUTES=30

# pgAdmin container login. Use a real-looking domain; .local is rejected by recent pgAdmin builds.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
