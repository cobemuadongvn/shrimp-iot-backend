                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let r=pm.response.json();",
                  "if (r.data && r.data.id) pm.environment.set('commandId', r.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Arduino Get Pending Commands",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/commands/pending?deviceId=device_01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commands",
                "pending?deviceId=device_01"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let r=pm.response.json();",
                  "let d=r.data;",
                  "if (Array.isArray(d) && d.length>0) pm.environment.set('commandId', d[0].id);",
                  "else if (d && d.id) pm.environment.set('commandId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Arduino ACK Command",
          "request": {
            "method": "POST",
            "header": [
